# Base de datos
# En producción podés usar DATABASE_URL de Neon directamente.
# DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require
# DB_SSL=true

# Alternativa local / variables separadas:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nordepo
DB_USER=guido
DB_PASSWORD=

# Servidor
PORT=3001
FRONTEND_URL=http://localhost:3000

# JWT (obligatorio en producción: cadena larga y aleatoria)
JWT_SECRET=cambiar_por_una_cadena_larga_y_secreta
# JWT_EXPIRES_IN=3650d

# Código maestro para “¿Olvidaste tu contraseña?” (sin email / sin servicios pagos)
# Guardalo vos como proveedor; opcionalmente se lo das al dueño del local.
PASSWORD_RESET_CODE=cambiar_codigo_recuperacion_secreto

# Primer usuario (solo al correr: npm run init-db)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar_esta_clave
